# Daily Report Digest Configuration
# Copy this file to .env and fill in your values

# Email service (gmail, outlook, etc.)
EMAIL_SERVICE=gmail

# Your email address (sender)
EMAIL_USER=your-email@gmail.com

# App-specific password (NOT your regular password)
# For Gmail: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your-app-specific-password

# Recipient email address for daily digests
REPORT_EMAIL_TO=ericmad14@gmail.com

# Timezone for scheduling (e.g., UTC, America/New_York, Europe/London)
TIMEZONE=UTC
